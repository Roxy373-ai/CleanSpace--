<Window x:Class="CleanSpace.Views.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanSpace | 语言 / 언어" Width="540" Height="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Assets/CleanSpace.png" Background="#F7F9FC">
  <Grid Margin="36">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image Source="/Assets/CleanSpace.png" Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
    <StackPanel Grid.Row="1" Margin="0,12,0,18">
      <TextBlock Text="请选择语言 · 언어를 선택하세요" FontSize="25" FontWeight="SemiBold" Foreground="#10253D" HorizontalAlignment="Center"/>
      <TextBlock Text="每次启动都可以选择 · 실행할 때마다 선택할 수 있습니다" FontSize="13" Foreground="#61758B" Margin="0,8,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
      <Button Content="简体中文" Height="54" FontSize="17" Style="{StaticResource PrimaryButton}" Click="Chinese_Click"/>
      <Button Content="한국어" Height="54" FontSize="17" Click="Korean_Click"/>
    </StackPanel>
    <TextBlock Grid.Row="3" Text="CleanSpace | 허준영 制作 / 제작" Foreground="#718197" HorizontalAlignment="Center" Margin="0,12,0,0"/>
  </Grid>
</Window>
