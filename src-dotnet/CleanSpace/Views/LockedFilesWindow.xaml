<Window x:Class="CleanSpace.Views.LockedFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="520" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" Icon="/Assets/CleanSpace.png" Background="#F3F6FA">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="25" FontWeight="Bold" Foreground="#10253D"/>
    <TextBlock x:Name="Explanation" Grid.Row="1" Margin="0,8,0,14" FontSize="14" Foreground="#405B76" TextWrapping="Wrap"/>
    <DataGrid x:Name="LockedGrid" Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding}" RowHeight="54">
      <DataGrid.Columns>
        <DataGridTextColumn x:Name="PathColumn" Binding="{Binding Path}" Width="*" MinWidth="380"/>
        <DataGridTextColumn x:Name="ProcessColumn" Binding="{Binding ProcessText}" Width="250"/>
        <DataGridTextColumn x:Name="ErrorColumn" Binding="{Binding ErrorText}" Width="110"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ForceCloseButton" Background="#C53B3B" Foreground="White" BorderBrush="#C53B3B" Click="ForceClose_Click"/>
      <Button x:Name="CloseAppsButton" Style="{StaticResource PrimaryButton}" Click="CloseApps_Click"/>
      <Button x:Name="RetryButton" Click="Retry_Click"/>
      <Button x:Name="ScheduleButton" Click="Schedule_Click"/>
      <Button x:Name="SkipButton" Click="Skip_Click"/>
    </StackPanel>
  </Grid>
</Window>
