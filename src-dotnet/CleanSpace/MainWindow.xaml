<Window x:Class="CleanSpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:CleanSpace.Services"
        Title="CleanSpace" Width="1420" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Icon="/Assets/CleanSpace.png" Background="{StaticResource PageBackground}">
  <Window.Resources>
    <svc:RiskTextConverter x:Key="RiskText"/>
    <svc:RiskBrushConverter x:Key="RiskBrush"/>
    <svc:KeyTextConverter x:Key="KeyText"/>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#D8E0E9" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/Assets/CleanSpace.png" Width="52" Height="52" Stretch="Uniform"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CleanSpace" FontSize="23" FontWeight="Bold" Foreground="#10253D"/>
            <TextBlock x:Name="AuthorText" Text="項堨鞓?鍒朵綔" FontSize="12" Foreground="#61758B"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ScanSystemButton" Click="ScanSystem_Click"/>
          <Button x:Name="ScanAllButton" Style="{StaticResource PrimaryButton}" Click="ScanAll_Click"/>
          <Button x:Name="RefreshDrivesButton" Click="RefreshDrives_Click"/>
          <Button x:Name="AdminButton" Click="Admin_Click"/>
          <Button x:Name="PauseButton" Click="Pause_Click" IsEnabled="False"/>
          <Button x:Name="CancelButton" Click="Cancel_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
        <StackPanel Margin="0,12">
          <Button x:Name="NavDashboard" Tag="DashboardPage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
          <Button x:Name="NavSpace" Tag="SpacePage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
          <Button x:Name="NavMedia" Tag="MediaPage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
          <Button x:Name="NavDuplicates" Tag="DuplicatesPage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
          <Button x:Name="NavApps" Tag="AppsPage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
          <Button x:Name="NavCleanup" Tag="CleanupPage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
          <Button x:Name="NavHistory" Tag="HistoryPage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
          <Button x:Name="NavSettings" Tag="SettingsPage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
          <Button x:Name="NavAbout" Tag="AboutPage" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="28,22">
        <Grid x:Name="DashboardPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock x:Name="DashboardTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D"/>
          <Border x:Name="PermissionBanner" Grid.Row="1" Background="#FFF7E8" BorderBrush="#E8C97A" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,16,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="PermissionTitle" FontSize="16" FontWeight="SemiBold" Foreground="#5E4511"/>
                <TextBlock x:Name="PermissionText" Margin="0,5,16,0" Foreground="#725923" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ContinueStandardButton" Click="ContinueStandard_Click"/>
                <Button x:Name="RestartAdminButton" Style="{StaticResource PrimaryButton}" Click="Admin_Click"/>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock x:Name="ScanChoiceText" Grid.Row="2" Margin="2,14,0,0" Foreground="#405B76" TextWrapping="Wrap"/>
          <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,12,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Image Source="/Assets/CleanSpace.png" Width="72" Height="72" Stretch="Uniform"/>
              <TextBlock x:Name="DashboardSummary" Grid.Column="1" FontSize="17" Foreground="#314B67" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DriveRows}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Width="330" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,14,14">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TypeKey, Converter={StaticResource KeyText}}" Foreground="#61758B" Margin="0,4,0,0"/>
                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Height="16" Margin="0,16,0,7"/>
                    <TextBlock Text="{Binding UsageText}" Foreground="#52677D"/>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="SpacePage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="126"/></Grid.RowDefinitions>
          <TextBlock x:Name="SpaceTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D"/>
          <Grid Grid.Row="1" Margin="0,18,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SpaceFilter" Height="40" Padding="12,8" FontSize="14" TextChanged="SpaceFilter_TextChanged"/>
            <Button x:Name="SpaceAddButton" Grid.Column="1" Click="AddSelectedRecord_Click"/>
          </Grid>
          <DataGrid x:Name="SpaceGrid" Grid.Row="2" ItemsSource="{Binding SpaceRows}" AutoGenerateColumns="False" SelectionChanged="RecordGrid_SelectionChanged" MouseDoubleClick="RecordGrid_DoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn x:Name="SpaceNameColumn" Binding="{Binding Name}" Width="220" SortMemberPath="Name"/>
              <DataGridTextColumn x:Name="SpacePathColumn" Binding="{Binding FullPath}" Width="*" MinWidth="420" SortMemberPath="FullPath"/>
              <DataGridTextColumn x:Name="SpaceDriveColumn" Binding="{Binding Drive}" Width="80"/>
              <DataGridTextColumn x:Name="SpaceSizeColumn" Binding="{Binding SizeText}" Width="110" SortMemberPath="Size"/>
              <DataGridTemplateColumn x:Name="SpaceRiskColumn" Width="145" SortMemberPath="Risk"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Risk, Converter={StaticResource RiskText}}" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="SpaceDetail" TextWrapping="Wrap" Foreground="#29445F" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SpaceOpenButton" Click="OpenSelected_Click"/><Button x:Name="SpaceLocateButton" Click="LocateSelected_Click"/></StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="MediaPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock x:Name="MediaTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
            <Button x:Name="MediaCheckButton" Click="CheckMedia_Click"/><Button x:Name="MediaOpenButton" Click="OpenSelected_Click"/><Button x:Name="MediaLocateButton" Click="LocateSelected_Click"/><Button x:Name="MediaAddButton" Click="AddSelectedRecord_Click"/>
          </StackPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="MediaGrid" ItemsSource="{Binding MediaRows}" AutoGenerateColumns="False" SelectionChanged="RecordGrid_SelectionChanged" MouseDoubleClick="RecordGrid_DoubleClick" LoadingRow="MediaGrid_LoadingRow" RowHeight="70">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="84"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="72" Height="56" Background="#E8EDF4"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn x:Name="MediaNameColumn" Binding="{Binding Name}" Width="210"/>
                <DataGridTextColumn x:Name="MediaPathColumn" Binding="{Binding FullPath}" Width="*" MinWidth="330"/>
                <DataGridTextColumn x:Name="MediaSizeColumn" Binding="{Binding SizeText}" Width="105" SortMemberPath="Size"/>
                <DataGridTextColumn x:Name="MediaStatusColumn" Binding="{Binding MediaStatus, Converter={StaticResource KeyText}}" Width="115"/>
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0" Padding="12">
              <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Image x:Name="MediaPreview" Stretch="Uniform"/>
                <TextBlock x:Name="MediaDetail" Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" Foreground="#52677D" Margin="0,12,0,6"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="DuplicatesPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock x:Name="DuplicatesTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,8"><Button x:Name="FindDuplicatesButton" Click="FindDuplicates_Click"/><Button x:Name="FindSimilarPhotosButton" Click="FindSimilarPhotos_Click"/><Button x:Name="SelectDuplicatesButton" Click="SelectDuplicates_Click"/><Button x:Name="DuplicateLocateButton" Click="LocateDuplicate_Click"/><Button x:Name="DuplicateAddButton" Click="AddDuplicate_Click"/></StackPanel>
          <TextBlock x:Name="DuplicateSummary" Grid.Row="2" FontSize="15" Foreground="#405B76" Margin="4,0,0,10"/>
          <DataGrid x:Name="DuplicateGrid" Grid.Row="3" ItemsSource="{Binding DuplicateRows}" AutoGenerateColumns="False" SelectionMode="Extended" MouseDoubleClick="DuplicateGrid_DoubleClick">
            <DataGrid.Columns><DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, Mode=TwoWay}" Width="48"/><DataGridTextColumn Header="#" Binding="{Binding GroupText}" Width="70"/><DataGridTextColumn x:Name="DuplicateNameColumn" Binding="{Binding Name}" Width="220"/><DataGridTextColumn x:Name="DuplicatePathColumn" Binding="{Binding FullPath}" Width="*" MinWidth="500"/><DataGridTextColumn x:Name="DuplicateSizeColumn" Binding="{Binding SizeText}" Width="120"/></DataGrid.Columns>
          </DataGrid>
        </Grid>

        <Grid x:Name="AppsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="AppsTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10"><Button x:Name="AppsRefreshButton" Click="RefreshApps_Click"/><Button x:Name="AppsUninstallButton" Click="UninstallApp_Click"/><Button x:Name="AppsCheckResidualsButton" Click="CheckAppResiduals_Click"/><Button x:Name="AppsRecycleResidualsButton" Click="RecycleAppResiduals_Click"/></StackPanel>
          <DataGrid x:Name="AppsGrid" Grid.Row="2" ItemsSource="{Binding AppRows}" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="52">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Grid Width="28" Height="28"><Border Background="#E7EEF6" CornerRadius="5"/><TextBlock Text="APP" FontSize="8" Foreground="#7890A8" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Width="24" Height="24"/></Grid>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn x:Name="AppsNameColumn" Binding="{Binding Name}" Width="230"/>
              <DataGridTextColumn x:Name="AppsPublisherColumn" Binding="{Binding Publisher}" Width="180"/>
              <DataGridTextColumn x:Name="AppsVersionColumn" Binding="{Binding Version}" Width="120"/>
              <DataGridTextColumn x:Name="AppsSizeColumn" Binding="{Binding SizeText}" Width="110" SortMemberPath="EstimatedSize"/>
              <DataGridTextColumn x:Name="AppsLocationColumn" Binding="{Binding InstallLocation}" Width="*" MinWidth="350"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="ResidualTitle" Grid.Row="3" Margin="2,12,0,7" FontSize="16" FontWeight="SemiBold" Foreground="#29445F"/>
          <DataGrid x:Name="ResidualGrid" Grid.Row="4" ItemsSource="{Binding ResidualRows}" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn x:Name="ResidualSelectColumn" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
              <DataGridTextColumn x:Name="ResidualSourceColumn" Binding="{Binding SourceKey, Converter={StaticResource KeyText}}" Width="190"/>
              <DataGridTextColumn x:Name="ResidualLocationColumn" Binding="{Binding Location}" Width="*"/>
              <DataGridTextColumn x:Name="ResidualRiskColumn" Binding="{Binding RiskKey, Converter={StaticResource KeyText}}" Width="260"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="ResidualHint" Grid.Row="5" Margin="2,7,0,0" Foreground="#61758B" TextWrapping="Wrap"/>
        </Grid>

        <Grid x:Name="CleanupPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="118"/></Grid.RowDefinitions>
          <TextBlock x:Name="CleanupTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,8"><Button x:Name="SelectSafeButton" Click="SelectSafe_Click"/><Button x:Name="SelectAllowedButton" Click="SelectAllowed_Click"/><Button x:Name="ClearSelectionButton" Click="ClearSelection_Click"/><Button x:Name="RemoveCleanupButton" Click="RemoveSelectedCleanup_Click"/><Button x:Name="RecycleButton" Style="{StaticResource PrimaryButton}" Click="Recycle_Click"/><Button x:Name="PermanentDeleteButton" Background="#C53B3B" Foreground="White" BorderBrush="#C53B3B" Click="PermanentDelete_Click"/></StackPanel>
          <TextBlock x:Name="CleanupSummary" Grid.Row="2" FontSize="15" Foreground="#405B76" Margin="4,0,0,10"/>
          <DataGrid x:Name="CleanupGrid" Grid.Row="3" ItemsSource="{Binding CleanupRows}" AutoGenerateColumns="False" IsReadOnly="False" SelectionChanged="CleanupGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn x:Name="CleanupSelectColumn" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" IsReadOnly="False"/>
              <DataGridTextColumn x:Name="CleanupPathColumn" Binding="{Binding FullPath}" Width="*" MinWidth="520" IsReadOnly="True"/>
              <DataGridTextColumn x:Name="CleanupSizeColumn" Binding="{Binding SizeText}" Width="110" IsReadOnly="True" SortMemberPath="File.Size"/>
              <DataGridTemplateColumn x:Name="CleanupRiskColumn" Width="145" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Risk, Converter={StaticResource RiskText}}" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn x:Name="CleanupReasonColumn" Binding="{Binding ReasonKey, Converter={StaticResource KeyText}}" Width="260" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0"><TextBlock x:Name="CleanupDetail" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#29445F"/></Border>
        </Grid>

        <Grid x:Name="HistoryPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="HistoryTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D"/>
          <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding HistoryRows}" AutoGenerateColumns="False" Margin="0,18,0,0"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="180"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="120"/><DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="180"/></DataGrid.Columns></DataGrid>
        </Grid>

        <Grid x:Name="SettingsPage" Visibility="Collapsed"><StackPanel><TextBlock x:Name="SettingsTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D"/><TextBlock x:Name="SettingsText" FontSize="16" Foreground="#405B76" Margin="0,22,0,12"/><Button x:Name="LanguageButton" Width="180" HorizontalAlignment="Left" Click="ChangeLanguage_Click"/></StackPanel></Grid>
        <Grid x:Name="AboutPage" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="/Assets/CleanSpace.png" Width="180" Height="180" Stretch="Uniform"/><TextBlock x:Name="AboutTitle" FontSize="29" FontWeight="Bold" Foreground="#10253D" HorizontalAlignment="Center" Margin="0,16,0,10"/><TextBlock x:Name="AboutText" FontSize="16" Foreground="#405B76" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="650"/></StackPanel></Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="#D8E0E9" BorderThickness="0,1,0,0">
      <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#405B76" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="ScanProgress" Grid.Column="1" Height="8" VerticalAlignment="Center" IsIndeterminate="False"/></Grid>
    </Border>
  </Grid>
</Window>

